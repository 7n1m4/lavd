# SPDX-License-Identifier: GPL-2.0
#
# AnimaSchedEXT — Hyprland focus daemon (systemd USER service)
#
# Subscribes to Hyprland's activewindowv2 events and pushes the focused
# PID into scx_lavd's pinned anima_active_pids BPF map. LAVD then gives
# that PID the tightest virtual deadline (see anima.bpf.h).
#
# Why a user service (not a system service)?
#   The daemon needs HYPRLAND_INSTANCE_SIGNATURE and XDG_RUNTIME_DIR to
#   talk to the Hyprland IPC socket. These env vars are only present in
#   the user's graphical session — a system service can't see them
#   without ugly passthrough hacks. Plus the pins are chmod 666 so no
#   root/CAP_BPF is required to update the maps.
#
# Install:
#   install -Dm644 anima-hypr.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anima-hypr.service
#
# Logs:
#   journalctl --user -u anima-hypr.service -f

[Unit]
Description=AnimAIOS Hyprland focus daemon (scx_lavd boost)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# window+tree: boost focused PID + its low-CPU direct children. Switch to
# just "window" if you want the focused process only (no descendants).
ExecStart=/usr/local/bin/anima-hypr-daemon window+tree
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
