              target/ci/scx_${sched} ${flags[$sched]:-"-v"}
            rc=$?
            kill $stress_pid 2>/dev/null || true
            wait $stress_pid 2>/dev/null || true
            if [ $rc -ne 0 ]; then
              failed="${failed} ${sched}"
              results[$sched]="FAIL"
            else
              passed="${passed} ${sched}"
              results[$sched]="PASS"
            fi
          done
          echo ""
          echo "=== Scheduler Test Results ==="
          if [ -n "$passed" ]; then
            echo "✅ Passed:${passed}"
          fi
          if [ -n "$failed" ]; then
            echo "❌ Failed:${failed}"
          fi
          {
            echo "| Scheduler | Result |"
            echo "|-----------|--------|"
            for sched in ${{ matrix.scheds }}; do
              if [ "${results[$sched]}" = "PASS" ]; then
                echo "| ${sched} | ✅ |"
              else
                echo "| ${sched} | ❌ |"
