   374	/// Parse `pactl list sink-inputs` output and return the set of PIDs that
   375	/// currently own a sink-input (i.e. are actively playing audio via
   376	/// PulseAudio or PipeWire's pulse layer). Empty set when nothing is
   377	/// playing or when `pactl` is unavailable. Lines of interest look like:
   378	///     application.process.id = "12345"
   379	fn sample_audio(cmd: &str) -> io::Result<HashSet<u32>> {
   380	    let out = std::process::Command::new(cmd)
   381	        .args(["list", "sink-inputs"])
   382	        .output()?;
   383	    let s = String::from_utf8_lossy(&out.stdout);
   384	    let mut set = HashSet::new();
   385	    for line in s.lines() {
   386	        let line = line.trim();
   387	        if let Some(rest) = line.strip_prefix("application.process.id") {
   388	            let v = rest.trim().trim_start_matches('=').trim().trim_matches('"');
   389	            if let Ok(pid) = v.parse::<u32>() {
   390	                set.insert(pid);
   391	            }
   392	        }
   393	    }
   394	    Ok(set)
   395	}
