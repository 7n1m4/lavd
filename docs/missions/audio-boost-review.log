   397	/// Build an address → PID lookup table from `hyprctl clients -j`.
   398	fn build_pid_cache() -> Result<HashMap<u64, u32>> {
   399	    let out = std::process::Command::new("hyprctl")
   400	        .args(["clients", "-j"])
   401	        .output()
   402	        .with_context(|| "failed to spawn hyprctl clients")?;
   403	    if !out.status.success() {
   404	        return Ok(HashMap::new());
   405	    }
   406	    let entries: Vec<serde_json::Value> =
   407	        serde_json::from_slice(&out.stdout).with_context(|| "parse hyprctl clients")?;
   408	    let mut cache = HashMap::with_capacity(entries.len());
   409	    for e in entries {
   410	        let addr = e["address"]
   411	            .as_str()
   412	            .and_then(|s| u64::from_str_radix(s.trim_start_matches("0x"), 16).ok());
   413	        let pid = e["pid"].as_u64().map(|p| p as u32);
   414	        if let (Some(addr), Some(pid)) = (addr, pid) {
   415	            if pid >= 1 {
   416	                cache.insert(addr, pid);
   417	            }
   418	        }
   419	    }
   420	    Ok(cache)
   421	}
   422	
   423	/// Hyprland event address → PID. Cache hit preferred; falls back to
   424	/// `hyprctl activewindow -j` on miss and inserts into cache. Returns
   425	/// None on error or if PID is 0 (kernel scheduler).
   426	fn lookup_pid(addr: u64, cache: &mut HashMap<u64, u32>) -> Option<u32> {
   427	    if let Some(p) = cache.get(&addr).copied() {
   428	        return Some(p);
   429	    }
   430	    let Ok(out) = std::process::Command::new("hyprctl")
   431	        .args(["activewindow", "-j"])
   432	        .output()
   433	    else {
   434	        return None;
   435	    };
   436	    if !out.status.success() {
   437	        return None;
   438	    }
   439	    let Ok(json) = serde_json::from_slice::<serde_json::Value>(&out.stdout) else {
   440	        return None;
   441	    };
   442	    let pid = json["pid"].as_u64().map(|p| p as u32)?;
   443	    if pid == 0 {
   444	        return None;
   445	    }
   446	    cache.insert(addr, pid);
   447	    Some(pid)
   448	}
