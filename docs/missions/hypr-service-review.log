index 17feb0e..56270d9 100644
--- a/services/anima-hypr.service
+++ b/services/anima-hypr.service
@@ -1,38 +1,38 @@
 # SPDX-License-Identifier: GPL-2.0
 #
-# Anima Hyprland focus daemon for scx_lavd
+# AnimaSchedEXT — Hyprland focus daemon (systemd USER service)
 #
 # Subscribes to Hyprland's activewindowv2 events and pushes the focused
 # PID into scx_lavd's pinned anima_active_pids BPF map. LAVD then gives
-# that PID the tightest virtual deadline (see patch in
-# scheds/rust/scx_lavd/src/bpf/anima.bpf.h).
+# that PID the tightest virtual deadline (see anima.bpf.h).
+#
+# Why a user service (not a system service)?
+#   The daemon needs HYPRLAND_INSTANCE_SIGNATURE and XDG_RUNTIME_DIR to
+#   talk to the Hyprland IPC socket. These env vars are only present in
+#   the user's graphical session — a system service can't see them
+#   without ugly passthrough hacks. Plus the pins are chmod 666 so no
+#   root/CAP_BPF is required to update the maps.
 #
-# Must run as root (or CAP_BPF) to update the pinned map.
 # Install:
-#   sudo install -Dm644 anima-hypr.service /etc/systemd/system/
-#   sudo install -Dm755 target/release/examples/anima_hypr_daemon /usr/local/bin/
-#   sudo systemctl daemon-reload
-#   sudo systemctl enable anima-hypr.service
+#   install -Dm644 anima-hypr.service ~/.config/systemd/user/
+#   systemctl --user daemon-reload
+#   systemctl --user enable --now anima-hypr.service
+#
+# Logs:
+#   journalctl --user -u anima-hypr.service -f
 
 [Unit]
-Description=AnimAIOS Hyprland focus daemon
-After=scx_loader.service
-Requires=scx_loader.service
+Description=AnimAIOS Hyprland focus daemon (scx_lavd boost)
+PartOf=graphical-session.target
+After=graphical-session.target
 
 [Service]
 Type=simple
-# window: boost only the focused PID. This is the right default because
-# many GUI apps (terminals, IDEs, container tools) fork children that are
-# *background* compute — exactly what LAVD is meant to de-prioritize. If you
-# find the focused window still feels sluggish under load, switch to
-# window+tree, but note that this will also boost any compiler/encoder/etc.
-# running inside that window (see `pgrep -P` in `update_map`).
-ExecStart=/usr/local/bin/anima-hypr-daemon window
-ExecStop=/usr/local/bin/anima-hypr-daemon window
+# window+tree: boost focused PID + its low-CPU direct children. Switch to
+# just "window" if you want the focused process only (no descendants).
+ExecStart=/usr/local/bin/anima-hypr-daemon window+tree
 Restart=on-failure
 RestartSec=3
-User=root
-AmbientCapabilities=CAP_BPF CAP_SYS_ADMIN
 
 [Install]
-WantedBy=multi-user.target
+WantedBy=graphical-session.target

