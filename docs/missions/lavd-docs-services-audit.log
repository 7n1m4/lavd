    10	# SPDX-License-Identifier: GPL-2.0
    11	#
    12	# AnimaSchedEXT — Hyprland focus daemon (systemd USER service)
    13	#
    14	# Subscribes to Hyprland's activewindowv2 events and pushes the focused
