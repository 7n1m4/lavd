    41	# just "window" if you want the focused process only (no descendants).
    42	ExecStart=/usr/local/bin/anima-hypr-daemon window+tree
    43	Restart=on-failure
    44	RestartSec=3
    45
    46	[Install]
    47	WantedBy=graphical-session.target
    48	# SPDX-License-Identifier: GPL-2.0
    49	#
    50	# tmpfiles.d snippet for AnimaSchedEXT
